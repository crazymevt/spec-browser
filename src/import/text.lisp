;;;; text.lisp — plain text of nodes and blocks, for searching and for comparing with other renderings.

(in-package #:spec-import)

(defun nodes->text (nodes)
  (with-output-to-string (s)
    (labels ((walk (node)
               (cond ((stringp node) (write-string node s))
                     ((atom node))
                     (t (case (car node)
                          ((:par) (format s "~%~%"))
                          ((:row) (terpri s))
                          ((:cell) (write-char #\Space s))
                          ((:note :list-begin :list-end))
                          ((:caption) (write-string "Figure: " s) (mapc #'walk (cdr node)))
                          ((:sup) (write-char #\^ s) (mapc #'walk (cdr node)))
                          ((:sub) (mapc #'walk (cdr node)))
                          ((:sense) (write-char #\[ s) (mapc #'walk (cdr node)) (write-char #\] s))
                          ((:ref) (write-string (third node) s))
                          ((:secref) (write-string (third node) s))
                          ((:syntax) (walk-syntax node))
                          ((:table) (destructuring-bind (caption headers rows) (cdr node)
                                      (dolist (h headers) (mapc #'walk h) (write-char #\Space s))
                                      (terpri s) (mapc #'walk rows) (terpri s)
                                      (mapc #'walk caption)))
                          (t (mapc #'walk (cdr node)))))))
             (walk-syntax (node)
               (destructuring-bind (kind name args &key (values nil values-p)) (cdr node)
                 (if (eq kind :setf)
                     (progn (write-string "(setf (" s) (mapc #'walk name) (write-char #\Space s)
                            (mapc #'walk args) (write-string ") " s) (mapc #'walk values) (write-string ")" s))
                     (progn (mapc #'walk name) (write-char #\Space s) (mapc #'walk args)
                            (when values-p (write-string " ⇒ " s) (mapc #'walk values))))
                 (terpri s))))
      (mapc #'walk nodes))))

(defun blocks->text (blocks)
  (with-output-to-string (s)
    (dolist (block blocks)
      (ecase (car block)
        (:p (format s "~A~%~%" (nodes->text (cdr block))))
        (:code (format s "~A~%~%" (nodes->text (cdr block))))
        (:table (destructuring-bind (caption headers rows) (cdr block)
                  (format s "~{~A~^ ~}~%~A~%~A~%~%" (mapcar #'nodes->text headers)
                          (nodes->text rows) (nodes->text caption))))
        (:list (dolist (item (cdr block))
                 (dolist (part (cdr item))
                   (if (eq (car part) :label)
                       (format s "~A~%" (nodes->text (cdr part)))
                       (write-string (blocks->text (list part)) s)))))))))
