(in-package #:spec-browser.view)

(defvar *style* nil)

(defun insert-buffer-string (buffer string styles)
  (let* ((end-iter (gtk:text-buffer-get-end-iter buffer))
         (start-offset (gtk:text-iter-get-offset end-iter)))
    (gtk:text-buffer-insert buffer end-iter string -1)
    (dolist (key styles)
      (let ((tag (funcall *style* key)))
        (when tag
          (gtk:text-buffer-apply-tag buffer 
                                     tag 
                                     (gtk:text-buffer-get-iter-at-offset buffer start-offset)
                                     (gtk:text-buffer-get-end-iter buffer)))))))

(defun render-inlines (buffer inlines styles)
  (dolist (inline inlines)
    (render-inline buffer inline styles)))

(defun render-inline (buffer inline styles)
  (if (stringp inline)
      (insert-buffer-string buffer inline styles)
      (case (first inline)
        ((:ref :term :link :secref) (render-inlines buffer (cddr inline) (cons :link styles)))
        ((:code) (render-inlines buffer (rest inline) (cons :code styles)))
        ((:note) (render-inlines buffer (rest inline) (cons :note styles)))
        ((:param) (render-inlines buffer (rest inline) (cons :param styles)))
        ((:i) (render-inlines buffer (rest inline) (cons :italic styles)))
        ((:b) (render-inlines buffer (rest inline) (cons :bold styles)))
        (otherwise (render-inlines buffer (rest inline) styles)))))

(defun render-cells (buffer cells styles)
  (dolist (cell cells)
    (render-inlines buffer cell styles)
    (insert-buffer-string buffer (string #\tab) styles)))

(defun render-rows (buffer rows styles)
  (dolist (row rows)
    (render-cells buffer row styles)
    (insert-buffer-string buffer (string #\Newline) styles)))

(defun render-table (buffer table styles)
  (when table
    (when (eq :caption (first table))
      (render-inlines buffer (cadr table) styles)
      (insert-buffer-string buffer (string #\Newline) styles))
    (when (eq :header (first table))
      (render-cells buffer (cadr table) (cons :table-header styles))
      (insert-buffer-string buffer (string #\Newline) styles))
    (when (eq :rows (first table))
      (render-rows buffer (cadr table) styles)
      (insert-buffer-string buffer (string #\Newline) styles))
    (render-table buffer (rest table) styles)))
      
(defun render-syntax (buffer line styles)
  (render-inlines buffer (getf line :name) (cons :syntax-name styles))
  (insert-buffer-string buffer " " styles)
  (render-inlines buffer (getf line :args) styles)
  (when (getf line :values)
    (insert-buffer-string buffer " ⇒ " styles)
    (render-inlines buffer (getf line :values) styles)))

(defun render-blocks (buffer blocks styles)
  (dolist (b blocks)
    (render-block buffer b styles)
    (insert-buffer-string buffer (format nil "~%~%") styles)))

(defun render-block (buffer block styles)
  (case (first block)
    ((:heading) (render-inlines buffer (cddr block) (cons (case (cadr block)
                                                            ((1) :heading-1)
                                                            ((2) :heading-2)
                                                            ((3) :heading-3)
                                                            (otherwise :heading-4))
                                                          styles)))
    ((:p) (render-inlines buffer (rest block) styles))
    ((:quote) (render-blocks buffer (rest block) (cons :quote styles)))
    ((:code-block) (render-inlines buffer (cddr block) (cons :code-block styles)))
    ((:syntax) (render-syntax buffer (rest block) (cons :syntax styles)))
    ((:list) (dolist (item (rest block))
               (if (eq :label (first (second item)))
                   (progn
                     (render-inlines buffer (rest (second item)) (cons :marker styles))
                     (insert-buffer-string buffer " " (cons :marker styles))
                     (render-blocks buffer (cddr item) styles))
                   (progn
                     (insert-buffer-string buffer "• " (cons :marker styles))
                     (render-blocks buffer (rest item) styles)))))
    ((:table) (render-table buffer (rest block) (cons :table styles)))
    (otherwise (render-inlines buffer (rest block) styles))))

(defun render-entry (text-view entry &key docset (style (constantly nil)))
  (declare (ignore docset))
  (let ((buffer (gtk:text-view-buffer text-view))
        (*style* style)
        (styles (list :body))
        (kind (spec-docset:entry-kind-name entry)))
    (setf (gtk:text-buffer-text buffer) "")
    (insert-buffer-string buffer (format nil "~{~a~^, ~}" (spec-docset:entry-names entry)) (cons :title styles))
    (when kind
      (insert-buffer-string buffer " " styles)
      (insert-buffer-string buffer kind (cons :kind styles)))
    (insert-buffer-string buffer (string #\Newline) styles)
    
    (loop for section in (spec-docset:entry-sections entry)
          for i from 0
          do
            (when (> i 0)
              (insert-buffer-string buffer (string #\Newline) styles))
            (insert-buffer-string buffer (first section) (cons :heading styles))
            (insert-buffer-string buffer (string #\Newline) styles)
            (render-blocks buffer (rest section) styles))))