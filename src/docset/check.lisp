;;;; check.lisp — checks a docset against docs/docset-format.md.

(in-package #:spec-docset)

(defparameter *block-types* '(:p :heading :code-block :syntax :list :table :quote))

(defparameter *inline-types* '(:code :i :b :param :ref :term :link :secref :sup :sub :sense
                               :math :input :note))

(defun check-docset (directory &key (stream *standard-output*) (limit 10))
  "Reads every entry of the docset in DIRECTORY and reports problems: duplicate
ids, links to entries that do not exist, unknown block or inline types, and index
positions that do not lead to their entry. Returns the number of problems."
  (let* ((docset (open-docset directory))
         (problems (make-hash-table :test 'equal))   ; kind -> (count . examples)
         (ids (make-hash-table :test 'equal)))
    (labels ((problem (kind detail)
               (let ((p (or (gethash kind problems) (setf (gethash kind problems) (list 0)))))
                 (incf (car p))
                 (when (< (length (cdr p)) limit) (push detail (cdr p)))))
             (known (id) (gethash id (docset-by-id docset)))
             (check-link (id where)
               (unless (known id) (problem "link to a missing entry" (format nil "~A in ~A" id where))))
             (check-inlines (inlines where)
               (dolist (x inlines)
                 (cond ((stringp x))
                       ((not (consp x)) (problem "inline that is not a string or list" (format nil "~S in ~A" x where)))
                       ((not (member (car x) *inline-types*)) (problem "unknown inline type" (format nil "~S in ~A" (car x) where)))
                       ((member (car x) '(:ref :term :link :secref))
                        (when (and (eq (car x) :ref) (second x)) (check-link (second x) where))
                        (check-inlines (cddr x) where))
                       (t (check-inlines (cdr x) where)))))
             (check-blocks (blocks where)
               (dolist (b blocks)
                 (cond ((not (and (consp b) (member (car b) *block-types*)))
                        (problem "unknown block type" (format nil "~S in ~A" (if (consp b) (car b) b) where)))
                       (t (case (car b)
                            ((:p) (check-inlines (cdr b) where))
                            ((:heading) (check-inlines (cddr b) where))
                            ((:code-block) (check-inlines (cddr b) where))
                            ((:syntax) (dolist (key '(:name :args :values))
                                         (check-inlines (getf (cdr b) key) where)))
                            ((:list) (dolist (item (cdr b))
                                       (dolist (part (cdr item))
                                         (if (eq (car part) :label)
                                             (check-inlines (cdr part) where)
                                             (check-blocks (list part) where)))))
                            ((:table) (check-inlines (getf (cdr b) :caption) where)
                             (dolist (cell (getf (cdr b) :header)) (check-inlines cell where))
                             (dolist (row (getf (cdr b) :rows))
                               (dolist (cell row) (check-inlines cell where))))
                            ((:quote) (check-blocks (cdr b) where)))))))
             (check-toc (nodes)
               (dolist (node nodes)
                 (let ((id (getf node :entry)))
                   (when id (check-link id (format nil "the table of contents (~A)" (getf node :title)))))
                 (check-toc (getf node :children)))))
      (dolist (record (docset-index docset))
        (let ((id (record-id record)))
          (if (gethash id ids)
              (problem "duplicate id" id)
              (setf (gethash id ids) t))
          (when (record-parent record) (check-link (record-parent record) id))
          (let ((entry (handler-case (docset-entry docset id)
                         (error (e) (problem "unreadable entry" (format nil "~A: ~A" id e)) nil))))
            (when entry
              (unless (equal (second entry) id)
                (problem "index position leads to another entry" (format nil "~A -> ~A" id (second entry))))
              (dolist (child (getf (cddr entry) :children)) (check-link child id))
              (loop for (label . blocks) in (entry-sections entry)
                    do (unless (stringp label) (problem "section label that is not a string" id))
                       (check-blocks blocks id))))))
      (check-toc (docset-toc docset))
      (let ((total 0))
        (format stream "~&~A (~A): ~D entries~%" (docset-title docset) (docset-directory docset)
                (length (docset-index docset)))
        (maphash (lambda (kind p)
                   (incf total (car p))
                   (format stream "  ~D ~A, such as:~%~{    ~A~%~}" (car p) kind (reverse (cdr p))))
                 problems)
        (when (zerop total) (format stream "  No problems.~%"))
        total))))
